---
// English-only layout for the /en/ section. Isolated from Layout.astro —
// safe to delete this file (and src/pages/en/) without touching the Korean site.
import "../styles/global.css";
import { SITE_URL } from "../site";

interface Props {
  title: string;
  description: string;
  canonical?: string;
  /** The Korean counterpart of this page, if one exists. */
  koUrl?: string;
}

const { title, description, canonical, koUrl } = Astro.props;
const site = SITE_URL;
const canonicalUrl = canonical || new URL(Astro.url.pathname, site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={canonicalUrl} />
    {koUrl && <link rel="alternate" hreflang="ko" href={koUrl} />}
    <link rel="alternate" hreflang="x-default" href={canonicalUrl} />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192x192.png" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="AngelDone" />
    <meta name="google-adsense-account" content="ca-pub-7048160642416104" />
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-7048160642416104" crossorigin="anonymous"></script>
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-46Z6P1GDG5"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-46Z6P1GDG5');
    </script>
    <slot name="head" />
  </head>
  <body class="min-h-screen bg-angel-bg text-angel-text antialiased">
    <header class="bg-angel-card/80 backdrop-blur-sm border-b border-angel-border sticky top-0 z-50">
      <div class="max-w-4xl mx-auto px-4 h-14 flex items-center justify-between">
        <a href="/en/" class="flex items-center gap-2 font-bold text-lg text-angel-accent hover:text-angel-primary transition-colors">
          👼 AngelDone
        </a>
        <nav class="hidden md:flex items-center gap-3 text-sm text-angel-muted">
          <a href="/en/category/love" class="hover:text-angel-primary transition-colors">❤️ Love</a>
          <a href="/en/category/money" class="hover:text-angel-primary transition-colors">💰 Money</a>
          <a href="/en/category/career" class="hover:text-angel-primary transition-colors">💼 Career</a>
          <a href="/en/category/spiritual" class="hover:text-angel-primary transition-colors">🔮 Spiritual</a>
          <a href="/en/category/twinflame" class="hover:text-angel-primary transition-colors">🔥 Twin Flame</a>
          <a href="/en/guide" class="hover:text-angel-primary transition-colors">📖 Guide</a>
        </nav>
        <button id="en-mobile-menu-btn" class="md:hidden text-angel-muted hover:text-angel-primary text-xl" aria-label="Open menu">☰</button>
      </div>
      <nav id="en-mobile-menu" class="hidden md:hidden border-t border-angel-border bg-angel-card/95 backdrop-blur-sm">
        <div class="max-w-4xl mx-auto px-4 py-3 flex flex-col gap-2 text-sm">
          <a href="/en/category/love" class="py-2 text-angel-muted hover:text-angel-primary transition-colors">❤️ Love</a>
          <a href="/en/category/money" class="py-2 text-angel-muted hover:text-angel-primary transition-colors">💰 Money</a>
          <a href="/en/category/career" class="py-2 text-angel-muted hover:text-angel-primary transition-colors">💼 Career</a>
          <a href="/en/category/spiritual" class="py-2 text-angel-muted hover:text-angel-primary transition-colors">🔮 Spiritual</a>
          <a href="/en/category/twinflame" class="py-2 text-angel-muted hover:text-angel-primary transition-colors">🔥 Twin Flame</a>
          <a href="/en/guide" class="py-2 text-angel-muted hover:text-angel-primary transition-colors">📖 Guide</a>
        </div>
      </nav>
    </header>
    <script>
      const btn = document.getElementById('en-mobile-menu-btn');
      const menu = document.getElementById('en-mobile-menu');
      btn?.addEventListener('click', () => menu?.classList.toggle('hidden'));
    </script>
    <main>
      <slot />
    </main>
    <footer class="bg-angel-card border-t border-angel-border mt-16">
      <div class="max-w-4xl mx-auto px-4 py-10 text-center text-sm text-angel-muted">
        <nav class="flex items-center justify-center gap-4 flex-wrap mb-4">
          <a href="/en/about" class="hover:text-angel-primary transition-colors">About</a>
          <a href="/en/contact" class="hover:text-angel-primary transition-colors">Contact</a>
          <a href="/en/privacy-policy" class="hover:text-angel-primary transition-colors">Privacy Policy</a>
        </nav>
        <p>© 2026 AngelDone. Angel number meanings, manifestation & twin flame guidance.</p>
      </div>
    </footer>
  </body>
</html>
