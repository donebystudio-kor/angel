---
// 번호 페이지 링크. 그 언어의 번호 페이지가 꺼져 있으면(src/config/locales.ts) 링크 없이 내용만 남긴다.
// 본문 속 링크용. 번호 목록·카드는 링크 없이 남기지 말고 영역째 숨긴다 (홈 참고).
import { numberPath } from "../lib/numberPages";
import type { Locale } from "../config/locales";

interface Props {
  locale: Locale;
  number: string;
  class?: string;
}

const { locale, number, class: className } = Astro.props;
const href = numberPath(locale, number);
---
{href ? <a href={href} class={className}><slot /></a> : <slot />}
