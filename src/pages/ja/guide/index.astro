---
// Japanese-only guide hub. Isolated under src/pages/ja/guide/.
import LayoutJa from "../../../layouts/LayoutJa.astro";
import { SITE_URL } from "../../../site";

const site = SITE_URL;
const title = "エンジェルナンバーガイド | AngelDone";
const description = "エンジェルナンバーとは何か、自分の数字の見つけ方、ツインレイ・ナンバーの意味まで、数字一つひとつの解説より深いところをまとめました。";
const url = `${site}/ja/guide/`;

const guides = [
  { slug: "what-is-an-angel-number", title: "エンジェルナンバーとは？", description: "この考え方がどこから来たのか、そしてのめり込みすぎずに向き合うための視点。", emoji: "👼" },
  { slug: "how-to-find-your-angel-number", title: "自分のエンジェルナンバーの見つけ方", description: "生年月日からライフパスナンバーを計算する方法と、日常で繰り返す数字に気づくコツ。", emoji: "🔍" },
  { slug: "twin-flame-numbers", title: "ツインレイ・ナンバーとは？", description: "出会いとサイレント期間、それぞれの局面でどんな数字が現れやすいか、その理由。", emoji: "🔥" },
];
---

<LayoutJa title={title} description={description} canonical={url}>
  <section class="max-w-3xl mx-auto px-4 py-12">
    <h1 class="text-3xl font-bold text-angel-text mb-3 text-center">📖 エンジェルナンバーガイド</h1>
    <p class="text-angel-muted text-center mb-10">数字ひとつの意味より、もう一歩深いところまで。</p>

    <div class="space-y-6">
      {guides.map((g) => (
        <a href={`/ja/guide/${g.slug}`} class="block bg-angel-card border border-angel-border rounded-2xl p-6 hover:border-angel-primary/50 hover:shadow-lg hover:shadow-angel-glow transition-all group">
          <div class="flex items-start gap-4">
            <span class="text-3xl">{g.emoji}</span>
            <div>
              <h2 class="text-xl font-bold text-angel-text group-hover:text-angel-primary transition-colors mb-2">{g.title}</h2>
              <p class="text-angel-muted">{g.description}</p>
              <span class="text-sm text-angel-primary mt-2 inline-block">続きを読む →</span>
            </div>
          </div>
        </a>
      ))}
    </div>

    <div class="mt-10 text-center">
      <a href="/ja/" class="text-angel-primary hover:text-angel-accent transition-colors text-sm">← エンジェルナンバー一覧</a>
    </div>
  </section>
</LayoutJa>
